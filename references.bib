@InProceedings{gilchrist2000,
author="Gilchrist, Robert
and Drinkwater, Denise",
editor="Bethlehem, Jelke G.
and van der Heijden, Peter G. M.",
title="The use of the Tweedie distribution in statistical modelling",
booktitle="COMPSTAT",
year="2000",
publisher="Physica-Verlag HD",
address="Heidelberg",
pages="313--318",
abstract="This paper discusses the estimation of the parameters of the so-called Tweedie distribution, TP($\mu$, $\sigma$2). Two special cases are considered, namely the Compound Poisson (1 < p < 2) and the Stable form (p > 2). The former is appropriate for data with a non-zero probability of zero observations and the latter is appropriate for data with a large dispersion. Our models will assume that we have data Yi, i = 1,{\ldots}, N, with differing means $\mu$i, with common p and $\sigma$2. The Tp ($\mu$i, $\sigma$2) distribution can be characterised by Var(Yi) = $\sigma$2$\mu$ip, i = 1,{\ldots}, N. In general, we shall model the $\mu$i in terms of explanatory variates xij, i = 1,{\ldots}, N, j= 1,{\ldots}, m. We discuss how it is straightforward to construct the maximum likelihood estimates of p, $\mu$i, and $\sigma$ 2 in a GLM oriented computer package. The Tweedie distribution is used to model the alcohol consumption of British 16 and 17 year olds and randomised quantile residuals are used to validate the modelling.",
isbn="978-3-642-57678-2"
}

